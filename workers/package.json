{
  "name": "moocs-mcp-workers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "db:local": "wrangler d1 migrations apply moocs-mcp --local",
    "db:remote": "wrangler d1 migrations apply moocs-mcp --remote",
    "ingest": "tsx ingest/main.ts",
    "ingest:fixture": "tsx ingest/main.ts --out ../tests/fixtures/sample-out --jsonl ../tests/fixtures/sample-out/collect-slides.jsonl --jsonl ../tests/fixtures/sample-out/collect-contents.jsonl --aliases ../tests/fixtures/sample-out/aliases.json",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.86.0"
  }
}
